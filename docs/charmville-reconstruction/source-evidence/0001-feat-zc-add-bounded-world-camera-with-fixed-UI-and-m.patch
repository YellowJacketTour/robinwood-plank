 // Draws to framebuf.
 //
 // But if drawPassiveSubscreenSeparate is true: framebuf_no_passive_subscreen will also contain all
@@ -5830,6 +5928,39 @@ void draw_screen(bool showhero, bool runGeneric, bool drawPassiveSubscreenSepara
 
 	if(runGeneric) FFCore.runGenericPassiveEngine(SCR_TIMING_PRE_DRAW);
 
+	// Consume only the transaction prepared by the main game loop. Cutscene/map
+	// captures retain their legacy path; there is still exactly one compose call.
+	if (camera_frame && camera_frame->prepared && runGeneric && !drawPassiveSubscreenSeparate &&
+		!screenscrolling && !lensclk && camera_frame->map == cur_map && camera_frame->screen == cur_screen &&
+		camera_frame->offset == playing_field_offset && draw_screen_clip_rect_x1 == 0 &&
+		draw_screen_clip_rect_x2 == 255 && draw_screen_clip_rect_y1 == 0 && draw_screen_clip_rect_y2 == 231)
+	{
+		auto& frame = *camera_frame;
+		frame.prepared = false;
+		auto geometry = get_presentation_geometry({0, playing_field_offset, 256, viewport.h}, frame.zoom);
+		if (geometry && frame.targets.extent(presentation_camera::scratch_plane::world) ==
+			presentation_camera::surface_extent{geometry->world.w, geometry->world.h + playing_field_offset})
+		{
+			render_viewport_scope render_scope(*geometry);
+			using presentation_camera::scratch_plane;
+			auto* scene = frame.targets.get(scratch_plane::world);
+			auto* lights = frame.targets.get(scratch_plane::light);
+			if (!Hero.reprojectSpotlights(lights, get_render_viewport())) clear_bitmap(lights);
+			compose_scene({scene, frame.targets.get(scratch_plane::background), nullptr,
+				{frame.targets.get(scratch_plane::darkness), frame.targets.get(scratch_plane::translucent_darkness)}, lights},
+				showhero, runGeneric, false, classic_draw, old_layer_draw_order, effects, &frame.ui, [&]() {
+					clear_bitmap(framebuf);
+					stretch_blit(scene, framebuf, 0, playing_field_offset, geometry->world.w, geometry->world.h,
+						0, playing_field_offset, 256, viewport.h);
+					auto legacy_geometry = get_presentation_geometry({0, playing_field_offset, 256, viewport.h}, 1.0);
+					render_viewport_scope ui_scope(*legacy_geometry);
+					for (auto& command : frame.ui) command();
+				});
+			publish_world_camera(&*geometry);
+			return;
+		}
+	}
+	publish_world_camera(nullptr);
 	// Resolve the actual destinations after PRE_DRAW, preserving legacy timing.
 	compose_scene({framebuf, scrollbuf, framebuf_no_passive_subscreen,
 		{darkscr_bmp, darkscr_bmp_trans}, lightbeam_bmp},
@@ -8229,6 +8360,11 @@ static int32_t map_view_coord(int32_t span, int64_t pos, double scale)
