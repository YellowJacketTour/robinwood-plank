+struct world_camera_frame
+{
+    presentation_camera::bitmap_scratch_targets targets{presentation_camera::bitmap_scratch_backend()};
+    scene_ui_commands ui;
+    bool prepared = false;
+    double zoom = 1.0;
+    int map = -1, screen = -1, offset = 0;
+};
+static std::unique_ptr<world_camera_frame> camera_frame;
+
+void release_world_camera_frame() { camera_frame.reset(); }
+
+void begin_world_camera_frame()
+{
+    double requested = 1.0;
+#ifdef __EMSCRIPTEN__
+    requested = EM_ASM_DOUBLE({
+        window.charmvilleCameraReady = true;
+        const z = Number(window.charmvilleCameraZoom);
+        return Number.isFinite(z) ? z : 1;
+    });
+#endif
+    if (camera_frame) camera_frame->prepared = false;
+#ifdef __EMSCRIPTEN__
+    const bool open_overview = EM_ASM_INT({
+        const test = new URLSearchParams(location.search).get('test') || '';
+        const allowed = test.startsWith('/quests/charmville/homestead-region/');
+        window.charmvilleMapReady = allowed;
+        const requested = window.charmvilleOpenMap === true;
+        window.charmvilleOpenMap = false;
+        return allowed && requested;
+    });
+    if (open_overview && Playing && cur_screen < 128 && !screenscrolling)
+    {
+        EM_ASM({ window.charmvilleMapOpen = true; window.charmvilleCloseMap = false; });
+        ViewMap(true);
+        EM_ASM({ window.charmvilleMapOpen = false; });
+    }
+#endif
+    if (requested >= 1 || requested < .5 || !std::isfinite(requested) ||
+        !game || !is_in_scrolling_region() || screenscrolling || lensclk ||
+        is_extended_height_mode() || !framebuf) return;
+    auto geometry = get_presentation_geometry({0, playing_field_offset, 256, viewport.h}, requested);
+    if (!geometry) return;
+    const auto r = geometry->world;
+    if (r.h + playing_field_offset + 8 > 464) return;
+    if (!camera_frame) camera_frame = std::make_unique<world_camera_frame>();
+    auto& frame = *camera_frame;
+    auto result = frame.targets.ensure({{r.w, r.h + playing_field_offset},
+        {r.w, r.h + playing_field_offset + 8}, {r.w, r.h + playing_field_offset}, {r.w, r.h}});
+    if (result == presentation_camera::scratch_resize_result::invalid ||
+        result == presentation_camera::scratch_resize_result::allocation_failed) return;
+    // Same phase as the legacy clear: before START_FRAME and script accumulation.
+    clear_darkroom_bitmaps(frame.targets.get(presentation_camera::scratch_plane::darkness),
+        frame.targets.get(presentation_camera::scratch_plane::translucent_darkness));
+    frame.ui.clear();
+    frame.zoom = requested;
+    frame.map = cur_map; frame.screen = cur_screen; frame.offset = playing_field_offset;
+    frame.prepared = true;
+}
+
+static void publish_world_camera(const presentation_camera::geometry* geometry)
+{
+#ifdef __EMSCRIPTEN__
+    const auto r = geometry ? geometry->world : presentation_camera::rectangle{viewport.x, viewport.y, viewport.w, viewport.h};
+    EM_ASM({
+        window.charmvilleCameraActualZoom = $0;
+        window.charmvilleCameraViewport = ({x:$1,y:$2,width:$3,height:$4,targetX:0,targetY:$5,targetWidth:256,targetHeight:$6});
+    }, geometry ? geometry->requested_zoom : 1.0, r.x,r.y,r.w,r.h,playing_field_offset,viewport.h);
+#endif
+}
