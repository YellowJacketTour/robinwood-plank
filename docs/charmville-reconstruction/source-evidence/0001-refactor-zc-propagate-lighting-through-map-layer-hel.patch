+// Explicit script-light targets are borrowed for this draw only. Legacy public
+// overloads preserve their original global-plane behavior (including map capture).
+struct script_world_light_targets;
 void do_layer(BITMAP *bmp, int32_t type, const screen_handle_t& screen_handle, int32_t x, int32_t y);
+void do_layer(BITMAP *bmp, int32_t type, const screen_handle_t& screen_handle, int32_t x, int32_t y, const script_world_light_targets* world_lights);
 void do_layer_primitives(BITMAP *bmp, int32_t layer);
+void do_layer_primitives(BITMAP *bmp, int32_t layer, const script_world_light_targets* world_lights);
 void do_walkflags(const std::array<screen_handle_t, 7>& screen_handles ,int32_t x, int32_t y);
