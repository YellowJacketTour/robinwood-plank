diff --git a/src/zc/presentation_camera.h b/src/zc/presentation_camera.h
new file mode 100644
index 0000000..eb144fd
--- /dev/null
+++ b/src/zc/presentation_camera.h
@@ -0,0 +1,65 @@
+#ifndef ZC_PRESENTATION_CAMERA_H_
+#define ZC_PRESENTATION_CAMERA_H_
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+// Presentation only. Never use this rectangle for activation, collision, despawn,
+// script Viewport bindings, or authoritative interest management.
+namespace presentation_camera
+{
+struct rectangle { int x, y, w, h; };
+struct point { double x, y; };
+struct geometry
+{
+    rectangle world;
+    rectangle target;
+    double requested_zoom;
+
+    point world_to_target(point p) const
+    {
+        return {target.x + (p.x - world.x) * target.w / world.w,
+                target.y + (p.y - world.y) * target.h / world.h};
+    }
+    point target_to_world(point p) const
+    {
+        return {world.x + (p.x - target.x) * world.w / target.w,
+                world.y + (p.y - target.y) * world.h / target.h};
+    }
+};
+
+inline int centered_axis(int focus, int extent, int region_extent, bool bounded)
+{
+    if (!bounded) return focus - extent / 2;
+    // Negative origins deliberately expose empty letterbox space, never a clamp
+    // with its maximum below its minimum. Rendering must clip to valid terrain.
+    if (extent > region_extent) return (region_extent - extent) / 2;
+    return std::clamp(focus - extent / 2, 0, region_extent - extent);
+}
+
+// Invalid requests return no geometry; callers retain the last valid render
+// target. No allocation and no mutation of the legacy simulation viewport.
+inline std::optional<geometry> make(rectangle legacy, rectangle target,
+    int region_w, int region_h, double zoom, bool bounded)
+{
+    if (!std::isfinite(zoom) || zoom < 0.5 || zoom > 2.0 ||
+        legacy.w <= 0 || legacy.h <= 0 || legacy.w > 256 || legacy.h > 232 ||
+        target.w <= 0 || target.h <= 0 || target.w > 4096 || target.h > 4096 ||
+        region_w <= 0 || region_h <= 0 || region_w > 4096 || region_h > 1408 ||
+        legacy.x < -8192 || legacy.x > 8192 || legacy.y < -8192 || legacy.y > 8192)
+        return std::nullopt;
+
+    // Exact legacy view at 1x, including authored script-camera offsets.
+    rectangle visual = legacy;
+    if (zoom != 1.0)
+    {
+        visual.w = static_cast<int>(std::ceil(legacy.w / zoom));
+        visual.h = static_cast<int>(std::ceil(legacy.h / zoom));
+        visual.x = centered_axis(legacy.x + legacy.w / 2, visual.w, region_w, bounded);
+        visual.y = centered_axis(legacy.y + legacy.h / 2, visual.h, region_h, bounded);
+    }
+    return geometry{visual, target, zoom};
+}
+}
+#endif
diff --git a/src/zc/presentation_frame.h b/src/zc/presentation_frame.h
new file mode 100644
index 0000000..976c2db
--- /dev/null
+++ b/src/zc/presentation_frame.h
@@ -0,0 +1,19 @@
+#ifndef ZC_PRESENTATION_FRAME_H_
+#define ZC_PRESENTATION_FRAME_H_
+
+#include <cstdint>
+
+// Owned by one presentation transaction, never inferred from the engine's frame
+// number: legacy warps and cutscenes have their own drawing/advance loops.
+struct presentation_frame_effects
+{
+    bool lens_clock_consumed = false;
+
+    void consume_lens_clock(int16_t& clock)
+    {
+        if (lens_clock_consumed || !clock) return;
+        lens_clock_consumed = true;
+        --clock;
+    }
+};
+#endif
