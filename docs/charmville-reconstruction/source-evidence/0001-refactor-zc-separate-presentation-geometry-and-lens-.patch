-			draw_screen(true, true, drawPassiveSubscreenSeparate);
+			draw_screen(true, true, drawPassiveSubscreenSeparate, &screen_effects);
 		}
 		else FFCore.runGenericPassiveEngine(SCR_TIMING_POST_DRAW);
 
diff --git a/tests/presentation_camera_geometry.cpp b/tests/presentation_camera_geometry.cpp
new file mode 100644
index 0000000..3937b5b
--- /dev/null
+++ b/tests/presentation_camera_geometry.cpp
@@ -0,0 +1,37 @@
+#include "zc/presentation_camera.h"
+#include <cassert>
+#include <limits>
+
+int main()
+{
+    using namespace presentation_camera;
+    const rectangle target{0, 56, 256, 176};
+    const rectangle legacy{128, 88, 256, 176};
+    auto same = make(legacy, target, 512, 352, 1, true).value();
+    assert(same.world.x == 128 && same.world.y == 88);
+    assert(same.world.w == 256 && same.world.h == 176);
+    auto wide = make(legacy, target, 512, 352, 0.5, true).value();
+    assert(wide.world.x == 0 && wide.world.y == 0);
+    assert(wide.world.w == 512 && wide.world.h == 352);
+    assert(wide.target.y == 56 && wide.target.w == 256);
+    auto small_region = make({0, 0, 256, 176}, target, 256, 176, .5, true).value();
+    assert(small_region.world.x == -128 && small_region.world.y == -88);
+    auto authored = make({-17, 91, 256, 176}, target, 512, 352, 1, false).value();
+    assert(authored.world.x == -17 && authored.world.y == 91);
+    for (double zoom : {.5, .75, 1., 1.5, 2.})
+    {
+        auto g = make(legacy, target, 512, 352, zoom, true).value();
+        for (point p : {point{0, 0}, point{255.5, 175.5}, point{511, 351}})
+        {
+            auto back = g.target_to_world(g.world_to_target(p));
+            assert(std::abs(back.x - p.x) < 1e-9);
+            assert(std::abs(back.y - p.y) < 1e-9);
+        }
+        assert(legacy.x == 128 && legacy.y == 88 && legacy.w == 256 && legacy.h == 176);
+    }
+    assert(!make(legacy, target, 512, 352, 0, true));
+    assert(!make(legacy, target, 512, 352, 2.1, true));
+    assert(!make(legacy, target, 512, 352, std::numeric_limits<double>::quiet_NaN(), true));
+    assert(!make(legacy, {0, 0, 0, 176}, 512, 352, 1, true));
+    assert(!make(legacy, target, 0, 352, 1, true));
+}
diff --git a/tests/presentation_frame_effects.cpp b/tests/presentation_frame_effects.cpp
new file mode 100644
index 0000000..0d22a17
--- /dev/null
+++ b/tests/presentation_frame_effects.cpp
@@ -0,0 +1,32 @@
+#include "zc/presentation_frame.h"
+#include <cassert>
+
+int main()
+{
+    int16_t clock = 3;
+    presentation_frame_effects frame;
+    frame.consume_lens_clock(clock);
+    assert(clock == 2);
+    frame.consume_lens_clock(clock);
+    assert(clock == 2);
+    presentation_frame_effects next_frame;
+    next_frame.consume_lens_clock(clock);
+    assert(clock == 1);
+    // A zero clock is not a consumed effect; a script can activate it later.
+    clock = 0;
+    presentation_frame_effects inactive;
+    inactive.consume_lens_clock(clock);
+    clock = 1;
+    inactive.consume_lens_clock(clock);
+    assert(clock == 0);
+    inactive.consume_lens_clock(clock);
+    assert(clock == 0);
+    // Independent legacy draws preserve one decrement per draw, including
+    // negative clocks (preserve legacy semantics instead of normalizing here).
+    clock = -1;
+    presentation_frame_effects first;
+    first.consume_lens_clock(clock);
+    presentation_frame_effects second;
+    second.consume_lens_clock(clock);
+    assert(clock == -3);
+}
