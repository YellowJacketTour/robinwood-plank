+#ifndef ZC_PRESENTATION_BITMAP_TARGETS_H_
+#define ZC_PRESENTATION_BITMAP_TARGETS_H_
+#include "allegro.h"
+#include "zc/presentation_targets.h"
+namespace presentation_camera
+{
+using bitmap_scratch_targets = scratch_targets<BITMAP>;
+inline bitmap_scratch_targets::backend bitmap_scratch_backend()
+{
+    return {nullptr,
+        [](void*, int w, int h) { return create_bitmap_ex(8, w, h); },
+        [](void*, BITMAP* bitmap) { destroy_bitmap(bitmap); },
+        [](void*, BITMAP* bitmap) { clear_bitmap(bitmap); }};
+}
