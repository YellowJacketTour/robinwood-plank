 }
-render_viewport_scope::render_viewport_scope(const presentation_camera::geometry& geometry)
-    : previous_(render_viewport_override)
+render_viewport_scope::render_viewport_scope(const presentation_camera::geometry& geometry, BITMAP* world, BITMAP* background)
+    : previous_(render_viewport_override), previous_world_(render_world_target), previous_background_(render_background_target)
 {
     const auto& r = geometry.world;
     // Reject malformed/unbounded scratch requests while retaining parent state.
     if (r.w > 0 && r.h > 0 && r.w <= 512 && r.h <= 464 &&
         r.x >= -8192 && r.x <= 8192 && r.y >= -8192 && r.y <= 8192)
+    {
         render_viewport_override = viewport_t{r.x, r.y, r.w, r.h};
+        render_world_target = world;
+        render_background_target = background;
+    }
 }
 render_viewport_scope::~render_viewport_scope()
 {
     render_viewport_override = previous_;
+    render_world_target = previous_world_;
+    render_background_target = previous_background_;
 }
 
