diff --git a/src/zc/presentation_target_space.h b/src/zc/presentation_target_space.h
new file mode 100644
index 0000000..c15cd50
--- /dev/null
+++ b/src/zc/presentation_target_space.h
@@ -0,0 +1,16 @@
+#ifndef ZC_PRESENTATION_TARGET_SPACE_H_
+#define ZC_PRESENTATION_TARGET_SPACE_H_
+
+namespace presentation_camera
+{
+// Destination identity is part of the projection contract. Arbitrary offscreen
+// bitmaps stay local; explicitly registered scene targets use world coordinates.
+template <class Bitmap>
+constexpr bool uses_world_coordinates(const Bitmap* destination, const Bitmap* legacy_frame,
+    const Bitmap* legacy_background, const Bitmap* world, const Bitmap* background)
+{
+    return destination && (destination == legacy_frame || destination == legacy_background ||
+        destination == world || destination == background);
+}
+}
+#endif
diff --git a/tests/presentation_target_space.cpp b/tests/presentation_target_space.cpp
new file mode 100644
index 0000000..2d30c98
--- /dev/null
+++ b/tests/presentation_target_space.cpp
@@ -0,0 +1,25 @@
+#include "zc/presentation_target_space.h"
+#include <cassert>
+int main()
+{
+    int legacy_frame, legacy_background, scene, background, offscreen;
+    using presentation_camera::uses_world_coordinates;
+    auto world = [&](const int* destination) {
+        return uses_world_coordinates(destination, &legacy_frame, &legacy_background, &scene, &background);
+    };
+    assert(world(&legacy_frame));
+    assert(world(&legacy_background));
+    assert(world(&scene));
+    assert(world(&background));
+    assert(!world(&offscreen));
+    assert(!world(nullptr));
+    // A nested fixed-UI scope unregisters scratch targets; legacy frame remains
+    // projected using its own restored legacy viewport, offscreen art stays local.
+    assert(!uses_world_coordinates(&scene, &legacy_frame, &legacy_background, (int*)nullptr, (int*)nullptr));
+    assert(uses_world_coordinates(&legacy_frame, &legacy_frame, &legacy_background, (int*)nullptr, (int*)nullptr));
+    // Hero and terrain now subtract the same world origin before zoom.
+    int hero_x = 400, origin_x = 256;
+    int raster_x = hero_x - (world(&scene) ? origin_x : 0);
+    assert(raster_x == 144);
+    assert(raster_x / 2 == 72);
+}
