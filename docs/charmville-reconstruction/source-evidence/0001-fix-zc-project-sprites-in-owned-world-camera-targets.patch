 #include <memory>
 #ifdef __EMSCRIPTEN__
 #include <emscripten.h>
@@ -66,22 +67,35 @@ viewport_t viewport;
 // Rendering runs on the game thread. Nested passes restore their parent's view;
 // no code assigns to the simulation viewport on behalf of this context.
 static std::optional<viewport_t> render_viewport_override;
+static BITMAP* render_world_target;
+static BITMAP* render_background_target;
+bool is_world_render_target(const BITMAP* destination)
