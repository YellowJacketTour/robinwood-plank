From 159cadbf29215caceb76d049aaa553f65b871c3e Mon Sep 17 00:00:00 2001
From: YellowJacketTour <279183353+YellowJacketTour@users.noreply.github.com>
Date: Sun, 13 Sep 2026 06:55:07 -0500
Subject: [PATCH] refactor(zc): route lens script lighting to scene targets

---
 src/zc/maps.cpp   | 2 +-
 src/zc/zc_sys.cpp | 7 ++++++-
 src/zc/zc_sys.h   | 2 ++
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/zc/maps.cpp b/src/zc/maps.cpp
index 6ee9262..849853e 100644
--- a/src/zc/maps.cpp
+++ b/src/zc/maps.cpp
@@ -5792,7 +5792,7 @@ static void compose_scene(const scene_composition_targets& targets,
 
 	if (is_in_scrolling_region() && lensclk && !FFCore.system_suspend[susptLENS])
 	{
-		draw_lens_over(dest);
+		draw_lens_over(dest, &world_lights);
 		// Preserve the legacy script-visible phase: after lens art but before
 		// layer-6 text, subscreen primitives and POST_DRAW. The transaction owner
 		// permits exactly one clock advance even when future views share it.
diff --git a/src/zc/zc_sys.cpp b/src/zc/zc_sys.cpp
index c6fab0d..4d5e786 100644
--- a/src/zc/zc_sys.cpp
+++ b/src/zc/zc_sys.cpp
@@ -3076,6 +3076,11 @@ void draw_lens_under(BITMAP *dest, bool layer)
 }
 
 void draw_lens_over(BITMAP *dest)
+{
+	draw_lens_over(dest, nullptr);
+}
+
+void draw_lens_over(BITMAP *dest, const script_world_light_targets* world_lights)
 {
 	int w = 288;
 	int h = 240;
@@ -3099,7 +3104,7 @@ void draw_lens_over(BITMAP *dest)
 	}
 	
 	masked_blit(lens_scr, dest, w-(HeroX()+8)+viewport.x, h-(HeroY()+8)+viewport.y, 0, playing_field_offset, 256, viewport.h);
-	do_primitives(dest, SPLAYER_LENS_OVER);
+	do_primitives(dest, SPLAYER_LENS_OVER, 0, playing_field_offset, 0, world_lights);
 }
 
 void draw_wavy(BITMAP *source, BITMAP *target, int32_t amplitude, bool interpol)
diff --git a/src/zc/zc_sys.h b/src/zc/zc_sys.h
index ed24782..71c9f1c 100644
--- a/src/zc/zc_sys.h
+++ b/src/zc/zc_sys.h
@@ -26,7 +26,9 @@ void load_game_configs();
 void save_game_configs();
 
 void draw_lens_under(BITMAP *dest, bool layer);
+struct script_world_light_targets;
 void draw_lens_over(BITMAP *dest);
+void draw_lens_over(BITMAP *dest, const script_world_light_targets* world_lights);
 void fix_menu();
 int32_t onFullscreenMenu();
 void f_Quit(int32_t type);
-- 
2.52.0.windows.1

