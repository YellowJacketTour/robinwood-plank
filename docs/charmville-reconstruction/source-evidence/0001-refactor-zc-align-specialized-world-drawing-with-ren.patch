 	sprite::draw_hitbox();
 	if (!get_qr(qr_OLD_ITEM_HITBOXES) && info_bmp_enabled())
 	{
 		// Draw the new 'itembox'
 		start_info_bmp();
-		int x0 = x + itembox_xofs - viewport.x;
-		int y0 = y + playing_field_offset + itembox_yofs - (z + zofs) - fakez - viewport.y;
+		int x0 = x + itembox_xofs - render_view.x;
+		int y0 = y + playing_field_offset + itembox_yofs - (z + zofs) - fakez - render_view.y;
 		al_draw_int_rectangle(x0, y0, itembox_width, itembox_height, al_map_rgba(64,64,255,info_opacity), 1);
 		end_info_bmp();	
 	}
