From: YellowJacketTour <279183353+YellowJacketTour@users.noreply.github.com>
Date: Sun, 13 Sep 2026 06:31:39 -0500
Subject: [PATCH] refactor(zc): carry world lighting into freeform drawing

---
 src/ffc.cpp     |  9 +++++++--
 src/ffc.h       |  3 +++
 src/zc/maps.cpp | 40 +++++++++++++++++++++++-----------------
 src/zc/maps.h   |  3 ++-
 4 files changed, 35 insertions(+), 20 deletions(-)

diff --git a/src/ffc.cpp b/src/ffc.cpp
index 57e41b5..b6f9cdf 100644
--- a/src/ffc.cpp
+++ b/src/ffc.cpp
@@ -30,14 +30,19 @@ void ffcdata::draw(BITMAP* dest)
 }
 
 void ffcdata::draw_ffc(BITMAP* dest, int32_t xofs, int32_t yofs, bool overlay)
+{
+	draw_ffc(dest, xofs, yofs, overlay, nullptr);
+}
+
+void ffcdata::draw_ffc(BITMAP* dest, int32_t xofs, int32_t yofs, bool overlay, const script_world_light_targets* world_lights)
 {
 	if(!(flags&ffc_overlay) != !overlay) return; //force cast both of these to boolean. They're both not, so same as if they weren't not.
 	
 	#ifdef IS_PLAYER
-	do_primitives(dest, SPLAYER_SPRITE_TARGET_UNDER, getUID());
+	do_primitives(dest, SPLAYER_SPRITE_TARGET_UNDER, 0, playing_field_offset, getUID(), world_lights);
 	ScopeExitHandler exit_handler([&]()
 	{
-		do_primitives(dest, SPLAYER_SPRITE_TARGET_OVER, getUID());
+		do_primitives(dest, SPLAYER_SPRITE_TARGET_OVER, 0, playing_field_offset, getUID(), world_lights);
 	});
 	#endif
 
diff --git a/src/ffc.h b/src/ffc.h
index 54a8992..0e7d471 100644
--- a/src/ffc.h
+++ b/src/ffc.h
@@ -45,6 +45,8 @@ enum ffc_flags : uint32_t
 };
 } // ends namespace
 
+struct script_world_light_targets;
+
 class ffcdata : public sprite
 {
 public:
@@ -71,6 +73,7 @@ public:
 
 	void draw(BITMAP* dest) override;
 	void draw_ffc(BITMAP* dest, int32_t xofs, int32_t yofs, bool overlay);
+	void draw_ffc(BITMAP* dest, int32_t xofs, int32_t yofs, bool overlay, const script_world_light_targets* world_lights);
 
 	bool checkSolid() const;
 	virtual bool setSolid(bool set) override;
diff --git a/src/zc/maps.cpp b/src/zc/maps.cpp
