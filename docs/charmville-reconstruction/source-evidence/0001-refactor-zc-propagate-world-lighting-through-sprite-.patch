+// Compile-time contract: every specialized monster keeps its own context-aware
+// virtual draw. This catches accidentally falling back to enemy's implementation.
+#include "zc/guys.h"
+#include "zc/hero.h"
+#include "zc/weapons.h"
+#include "items.h"
+#include "ffc.h"
+#include <type_traits>
+
+template<class T>
+using context_draw = void (T::*)(BITMAP*, const script_world_light_targets*);
+static_assert(std::is_same_v<decltype(&enemy::draw), context_draw<enemy>>);
+static_assert(std::is_same_v<decltype(&guy::draw), context_draw<guy>>);
+static_assert(std::is_same_v<decltype(&eFire::draw), context_draw<eFire>>);
+static_assert(std::is_same_v<decltype(&eOther::draw), context_draw<eOther>>);
+static_assert(std::is_same_v<decltype(&eScript::draw), context_draw<eScript>>);
+static_assert(std::is_same_v<decltype(&eFriendly::draw), context_draw<eFriendly>>);
+static_assert(std::is_same_v<decltype(&eGhini::draw), context_draw<eGhini>>);
+static_assert(std::is_same_v<decltype(&eTektite::draw), context_draw<eTektite>>);
+static_assert(std::is_same_v<decltype(&eItemFairy::draw), context_draw<eItemFairy>>);
+static_assert(std::is_same_v<decltype(&ePeahat::draw), context_draw<ePeahat>>);
+static_assert(std::is_same_v<decltype(&eLeever::draw), context_draw<eLeever>>);
