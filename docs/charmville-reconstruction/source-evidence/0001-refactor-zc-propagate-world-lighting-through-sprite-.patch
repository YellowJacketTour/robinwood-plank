+
+// Legacy expressions still compile; explicit contexts use the same virtual slot.
+static void source_compatibility(sprite& base, enemy& npc, HeroClass& hero,
+    movingblock& block, sprite_list& list, BITMAP* dest,
+    const script_world_light_targets* lights)
+{
+    base.draw(dest);
+    base.draw(dest, lights);
+    npc.draw(dest, lights);
+    hero.draw(dest, lights);
+    block.draw(dest, -1);
+    block.draw(dest, -1, lights);
+    list.draw(dest, true);
+    list.draw(dest, true, lights);
+}
