{
  "name": "robinwood-plank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:relayer": "esbuild scripts/relay-drand.ts --bundle --platform=node --format=esm --target=node22 --outfile=.next/standalone/ops/drand-relayer/relay-drand.mjs",
    "build:market-refresh": "esbuild scripts/refresh-market-data.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:pg-native --outfile=.next/standalone/scripts/refresh-market-data.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:inmotion": "eslint app/api/health/route.ts lib/postgres.ts lib/public-json.ts lib/boards-store.ts lib/market/durable-kv.ts lib/market/orders-store.ts lib/market/served-orders.ts lib/market/rarity-snapshot.ts lib/market/vault-activity.ts lib/market/sales-catalog.ts lib/market/fetch-rpc.ts lib/market/rpc-budget.ts lib/market/rpc-cache.ts lib/market/rpc-meter.ts app/api/rpc/route.ts app/api/market/rpc-usage/route.ts scripts/refresh-market-data.ts test/market/durable-kv.test.ts test/market/sales-catalog-durability.test.ts test/market/rpc-cache.test.ts test/market/order-liveness.test.ts lib/market/order-status.ts test/market/vault-activity-cache.test.ts test/market/relay-drand.test.ts test/market/verify-relayer-log.test.ts scripts/migrate-postgres.mjs scripts/backup-postgres.mjs scripts/snapshot-vault-state.mjs scripts/postgres-maintenance.mjs scripts/verify-relayer-log.mjs scripts/verify-postgres-storage.ts scripts/relay-drand.ts deploy/inmotion/passenger.cjs next.config.ts",
    "test:contracts": "cross-env TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "test:market": "tsx --test test/market/*.test.ts",
    "test:postgres": "tsx scripts/verify-postgres-storage.ts",
    "test": "npm run test:market && npm run test:contracts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:maintenance": "node scripts/postgres-maintenance.mjs",
    "market:refresh": "tsx scripts/refresh-market-data.ts",
    "market:refresh:full": "tsx scripts/refresh-market-data.ts --full"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@opensea/seaport-js": "^4.1.5",
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-ethers": "1.8.23",
    "ethers": "^6.17.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.0"
  },
  "overrides": {
    "postcss": "^8.5.20",
    "sharp": "^0.35.0",
    "hardhat": {
      "adm-zip": "0.6.0",
      "undici": "6.27.0",
      "uuid": "11.1.1",
      "lodash": "4.18.1",
      "@sentry/node": {
        "cookie": "0.7.2"
      },
      "solc": {
        "tmp": "0.2.6"
      }
    },
    "@nomicfoundation/hardhat-verify": {
      "undici": "6.27.0"
    },
    "@nomicfoundation/ignition-core": {
      "lodash": "4.18.1"
    },
    "mocha": {
      "serialize-javascript": "7.0.5"
    }
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@openzeppelin/contracts": "^4.9.6",
    "@tailwindcss/postcss": "^4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "hardhat": "^2.29.0",
    "mocha": "^11.7.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.115.0"
  }
}
