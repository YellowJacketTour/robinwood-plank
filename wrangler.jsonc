{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plank-love",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "plank-love"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "workers_dev": true,
  "vars": {
    "NEXT_PUBLIC_MARKET_ENABLED": "true",
    "NEXT_PUBLIC_MARKET_VAULT_ADDRESS": "0xc4B29D7a01603D2A5937b1FC86ea85E488d72e04",
    "NEXT_PUBLIC_MARKET_VAULT_LEGACY_ADDRESS": "0xb2019Fd4cA24502e812C0C73b751Fa49979BF708",
    "NEXT_PUBLIC_MARKET_VAULT_LEGACY_ADDRESSES": "",
    "OPEN_NEXT_CLOUDFLARE": "1"
  },
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
