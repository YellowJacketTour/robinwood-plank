/**
 * UNTRACKED ANALYSIS ARTIFACT — differential fidelity proof for the corrected
 * Node model in docs/marketplank/sim-plankcrash/engine.mjs against the REAL
 * PlankCrashDrand.sol. Deploys the real contract with a toggleable jackpot
 * sink (contracts/test/sim-plankcrash/ToggleableJackpotSink.sol), drives a
 * scripted vector sequence (fund, bet, lock, reveal, settle, register, claim,
 * cash-out, busted+sweep, cap-overflow with sink OK and sink REVERTING, void
 * paths, hwm seed-halt, floor==cap failed-sink re-seed), and after EVERY
 * transition compares every reachable on-chain state variable to the model
 * stepped on the identical vector. Any mismatch throws.
 *
 * Transcript is written to docs/marketplank/sim-plankcrash/differential-transcript.json.
 */
import { expect } from "chai";
import { writeFileSync, mkdirSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, join } from "node:path";
import { ethers, networkHelpers } from "./helpers/hardhat.js";
import { hardeningFor } from "./helpers/crashHardening.js";
// @ts-ignore — plain-JS model, no types
import { Engine, deriveCrash } from "../../docs/marketplank/sim-plankcrash/engine.mjs";

const __dir = dirname(fileURLToPath(import.meta.url));
const SIM_DIR = join(__dir, "../../docs/marketplank/sim-plankcrash");

const DRAND_PERIOD = 3n;
const DRAND_GENESIS = 1727521075n;
const BETTING = 30;
const MAX_ELAPSED = 40;
const REG = 6;
const AWAIT = 60;
const E = (x: string) => ethers.parseEther(x);

const transcript: any[] = [];
const j = (o: any) => JSON.parse(JSON.stringify(o, (_, v) => (typeof v === "bigint" ? v.toString() : v instanceof Map ? Object.fromEntries(v) : v)));

async function deployPair(over: Record<string, any> = {}) {
  const signers = await ethers.getSigners();
  const [deployer, treasury, alice, bob, carol] = signers;
  const beacon: any = await (await ethers.getContractFactory("DrandBeaconMock")).deploy(DRAND_PERIOD, DRAND_GENESIS);
  const sink: any = await (await ethers.getContractFactory("ToggleableJackpotSink")).deploy();
  const cfg: Record<string, any> = {
    bettingDurationSeconds: BETTING,
    roundIntervalSeconds: 0,
    maxAwaitBlocks: AWAIT,
    maxElapsedBlocks: MAX_ELAPSED,
    registrationWindowBlocks: REG,
    rakeBps: 450n,
    minParticipants: 2n,
    minPoolSize: E("0.001"),
    maxStakePerWalletBps: 10000n,
    keeperRewardBps: 500n,
    seedNumerator: 1n,
    seedDenominator: 2n,
    reserveShareBps: 5000n,
    reserveFloorWei: 0n,
    reserveCap: E("2"),
    jackpotSink: await sink.getAddress(),
    treasury: treasury.address,
    beacon: await beacon.getAddress(),
    ...hardeningFor(MAX_ELAPSED),
    seedBootstrapBudgetWei: E("0.2"),
    ...over,
  };
  const crash: any = await (await ethers.getContractFactory("PlankCrashDrand")).deploy(cfg);
  const rcpt = await crash.deploymentTransaction()!.wait();
  const blk = await ethers.provider.getBlock(rcpt!.blockNumber);
  const model = new Engine(
    {
      rakeBps: cfg.rakeBps, minParticipants: cfg.minParticipants, minPoolSize: cfg.minPoolSize,
      maxStakePerWalletBps: cfg.maxStakePerWalletBps, keeperRewardBps: cfg.keeperRewardBps,
      keeperRevealBps: cfg.keeperRevealBps, keeperLockBps: cfg.keeperLockBps,
      seedNumerator: cfg.seedNumerator, seedDenominator: cfg.seedDenominator,
      reserveShareBps: cfg.reserveShareBps, reserveFloorWei: cfg.reserveFloorWei,
      reserveCap: cfg.reserveCap, jackpotSink: cfg.jackpotSink === ethers.ZeroAddress ? null : cfg.jackpotSink,
      seedMaxBps: cfg.seedMaxBps, singlePayoutCapBps: cfg.singlePayoutCapBps,
      dailyDrawdownBps: cfg.dailyDrawdownBps, hwmDrawdownBps: cfg.hwmDrawdownBps,
      maxMultiplierBps: cfg.maxMultiplierBps, registrationWindowBlocks: BigInt(REG),
      seedBootstrapBudgetWei: cfg.seedBootstrapBudgetWei,
    },
    BigInt(blk!.timestamp)
  );
  return { crash, beacon, sink, cfg, model, deployer, treasury, alice, bob, carol };
}

/** Compare every reachable on-chain state var to the model. */
async function sync(label: string, ctx: any) {
  const { crash, sink, model } = ctx;
  const s = model.snapshot();
  const checks: [string, bigint, bigint][] = [
    ["reserve", await crash.reserve(), s.reserve],
    ["seedBudget", await crash.seedBudget(), s.seedBudget],
    ["reserveHighWaterMark", await crash.reserveHighWaterMark(), s.reserveHighWaterMark],
    ["drawdownWindowStart", await crash.drawdownWindowStart(), s.drawdownWindowStart],
    ["drawdownWindowPeak", await crash.drawdownWindowPeak(), s.drawdownWindowPeak],
    ["accumulatedRake", await crash.accumulatedRake(), s.accumulatedRake],
    ["currentRoundId", await crash.currentRoundId(), s.currentRoundId],
    ["sinkBalance", await ethers.provider.getBalance(await sink.getAddress()), s.sinkBalance],
  ];
  // contract ETH balance identity
  const bal = await ethers.provider.getBalance(await crash.getAddress());
  const expectedBal = model.totalDeposits - s.sinkBalance - model.escrowTotal() - (model.paidOut ?? 0n);
  checks.push(["contractBalance", bal, expectedBal]);
  // round-level state for every round the model knows
  for (const [id, mr] of model.rounds) {
    const cr = await crash.rounds(id);
    checks.push(
      [`r${id}.phase`, BigInt(cr.phase), BigInt(mr.phase)],
      [`r${id}.pool`, cr.pool, mr.pool],
      [`r${id}.rolledOverFromPrevious`, cr.rolledOverFromPrevious, mr.rolledOverFromPrevious],
      [`r${id}.distributable`, cr.distributable, mr.phase === 2 ? mr.distributable : mr.distributable],
      [`r${id}.totalWinningWeight`, cr.totalWinningWeight, mr.totalWinningWeight],
      [`r${id}.provisionalWinningWeight`, cr.provisionalWinningWeight, mr.provisionalWinningWeight],
      [`r${id}.provisionalProfitWeight`, cr.provisionalProfitWeight, mr.provisionalProfitWeight],
      [`r${id}.totalWinningProfitWeight`, cr.totalWinningProfitWeight, mr.totalWinningProfitWeight],
      [`r${id}.reserveAtLock`, cr.reserveAtLock, mr.reserveAtLock],
      [`r${id}.crashElapsedBlocks`, cr.crashElapsedBlocks, mr.crashElapsedBlocks]
    );
    for (const [addr, p] of mr.players) {
      checks.push(
        [`r${id}.stakeOf(${addr.slice(0, 8)})`, await crash.stakeOf(id, addr), p.stake],
        [`r${id}.cashOutBlockOf`, await crash.cashOutBlockOf(id, addr), p.cashOutBlock],
        [`r${id}.registered`, BigInt(await crash.registered(id, addr) ? 1 : 0), BigInt(p.registered ? 1 : 0)],
        [`r${id}.claimed`, BigInt(await crash.claimed(id, addr) ? 1 : 0), BigInt(p.claimed ? 1 : 0)]
      );
    }
  }
  // escrow (pull payments)
  for (const [who, owed] of model.escrow) {
    checks.push([`payments(${who.slice(0, 8)})`, await crash.payments(who), owed]);
  }
  const mismatches = checks.filter(([, a, b]) => a !== b).map(([n, a, b]) => ({ field: n, chain: a.toString(), model: b.toString() }));
  transcript.push({ label, snapshot: j(s), mismatches });
  if (mismatches.length) {
    throw new Error(`DIFFERENTIAL MISMATCH at "${label}": ${JSON.stringify(mismatches)}`);
  }
}

async function lockAndFeed(ctx: any, keeper: any) {
  const { crash, model } = ctx;
  await networkHelpers.time.increase(BETTING + 1);
  const id = await crash.currentRoundId();
  const tx = await crash.connect(keeper).lockRound();
  const rc = await tx.wait();
  const blk = await ethers.provider.getBlock(rc.blockNumber);
  const cr = await crash.rounds(id);
  model.lockRound({
    blockNumber: BigInt(rc.blockNumber), timestamp: BigInt(blk!.timestamp),
    targetDrandRound: cr.targetDrandRound, revealNotBefore: cr.revealNotBefore, keeper: keeper.address,
  });
  return { id, rc };
}

async function revealAndFeed(ctx: any, id: bigint, randomness: string, keeper: any) {
  const { crash, beacon, model } = ctx;
  const cr = await crash.rounds(id);
  const now = BigInt(await networkHelpers.time.latest());
  if (cr.revealNotBefore > now) await networkHelpers.time.increaseTo(cr.revealNotBefore);
  await beacon.setRandomness(cr.targetDrandRound, randomness);
  await crash.connect(keeper).revealEntropy(id);
  model.revealEntropy(id, BigInt(randomness), keeper.address);
}

async function settleAndFeed(ctx: any, id: bigint, keeper: any) {
  const { crash, model } = ctx;
  const cr = await crash.rounds(id);
  const eff = cr.trueCrashElapsedBlocks < BigInt(MAX_ELAPSED) ? cr.trueCrashElapsedBlocks : BigInt(MAX_ELAPSED);
  const cur = BigInt(await ethers.provider.getBlockNumber());
  const target = cr.lockBlock + eff;
  if (target > cur) await networkHelpers.mine(Number(target - cur));
  const tx = await crash.connect(keeper).settleRound(id);
  const rc = await tx.wait();
  const blk = await ethers.provider.getBlock(rc.blockNumber);
  model.settleRound(id, { blockNumber: BigInt(rc.blockNumber), timestamp: BigInt(blk!.timestamp), keeper: keeper.address });
}

async function bet(ctx: any, who: any, eth: string, auto: bigint) {
  await ctx.crash.connect(who).placeBet(auto, { value: E(eth) });
  ctx.model.placeBet(who.address, E(eth), auto);
}

function randomnessFor(label: string, pred: (elapsed: bigint) => boolean): string {
  for (let i = 0; i < 400; i++) {
    const v = ethers.keccak256(ethers.toUtf8Bytes(`${label}-${i}`));
    const { elapsedBlocks } = deriveCrash(BigInt(v));
    if (pred(elapsedBlocks)) return v;
  }
  throw new Error("no randomness found for " + label);
}

describe("sim-plankcrash differential: corrected Node model vs real PlankCrashDrand", () => {
  after(() => {
    mkdirSync(SIM_DIR, { recursive: true });
    writeFileSync(join(SIM_DIR, "differential-transcript.json"), JSON.stringify(transcript, null, 1));
  });

  it("V1..V14: full vector sequence incl. failed-sink overflow — model matches chain everywhere", async () => {
    const ctx = await deployPair();
    const { crash, sink, model, alice, bob, carol, deployer } = ctx;
    await sync("V0 deploy", ctx);

    // V1: fund below cap
    await crash.connect(deployer).fundVault({ value: E("1.5") });
    model.fundVault(E("1.5"));
    await sync("V1 fundVault 1.5 (below cap)", ctx);

    // V2: seeded round, auto winner + manual rider loser, settle/register/claim
    let id = await crash.currentRoundId();
    await bet(ctx, alice, "1", 10001n);
    await bet(ctx, bob, "1", 0n);
    await sync("V2a bets", ctx);
    await lockAndFeed(ctx, carol);
    await sync("V2b lock", ctx);
    await revealAndFeed(ctx, id, randomnessFor("v2", (e) => e >= 2n && e <= 40n), bob);
    await sync("V2c reveal", ctx);
    await settleAndFeed(ctx, id, deployer);
    await sync("V2d settle", ctx);
    await crash.registerResult(id, alice.address);
    model.registerResult(id, alice.address);
    await crash.registerResult(id, bob.address);
    model.registerResult(id, bob.address);
    await sync("V2e register", ctx);
    await networkHelpers.mine(REG + 1);
    await crash.claim(id, alice.address);
    model.claim(id, alice.address);
    await sync("V2f claim alice", ctx);

    // V3: overflow with sink OK
    await crash.fundVault({ value: E("3") });
    model.fundVault(E("3"));
    await sync("V3 fundVault 3 (spill, sink OK)", ctx);

    // V4/V5: overflow with sink REVERTING — excess retained in Vault
    await sink.setReverting(true);
    model.sinkOk = false;
    await crash.fundVault({ value: E("1") });
    model.fundVault(E("1"));
    await sync("V4 fundVault 1 (sink reverts, stranded)", ctx);
    expect(model.strandedOverflow).to.be.gt(0n);
    await crash.fundVault({ value: E("0.5") });
    model.fundVault(E("0.5"));
    await sync("V5 fundVault 0.5 (still stranded, grows)", ctx);

    // V6: sink recovers, tiny inflow flushes the whole stranded excess
    await sink.setReverting(false);
    model.sinkOk = true;
    await crash.fundVault({ value: 1n });
    model.fundVault(1n);
    await sync("V6 fundVault 1 wei (full spill retry)", ctx);
    expect(model.strandedOverflow).to.equal(0n);

    // V7: fully-busted round → sweep with sink REVERTING, windfall retained
    id = await crash.currentRoundId();
    await bet(ctx, alice, "0.4", 0n); // manual, never cashes out => loses
    await bet(ctx, bob, "0.4", 0n);
    await lockAndFeed(ctx, carol);
    await revealAndFeed(ctx, id, randomnessFor("v7", (e) => e >= 1n && e <= 40n), carol);
    await settleAndFeed(ctx, id, carol);
    await crash.registerResult(id, alice.address);
    model.registerResult(id, alice.address);
    await crash.registerResult(id, bob.address);
    model.registerResult(id, bob.address);
    await networkHelpers.mine(REG + 1);
    await sink.setReverting(true);
    model.sinkOk = false;
    await crash.sweepBustedRound(id);
    model.sweepBustedRound(id);
    await sync("V7 busted sweep (sink reverting)", ctx);

    // V8: manual cash-out path in a live round + winner claim with excess spill
    id = await crash.currentRoundId();
    await bet(ctx, alice, "0.6", 0n);
    await bet(ctx, bob, "0.6", 11900n); // high auto (near the 11920 cap), loses on early crashes
    await lockAndFeed(ctx, carol);
    {
      const tx = await crash.connect(alice).cashOut(id);
      const rc = await tx.wait();
      model.cashOut(id, alice.address, BigInt(rc.blockNumber));
    }
    await sync("V8a manual cashOut", ctx);
    await revealAndFeed(ctx, id, randomnessFor("v8", (e) => e >= 3n && e <= 20n), bob);
    await settleAndFeed(ctx, id, bob);
    await crash.registerResult(id, alice.address);
    model.registerResult(id, alice.address);
    await crash.registerResult(id, bob.address);
    model.registerResult(id, bob.address);
    await networkHelpers.mine(REG + 1);
    const won = model.round(id).players.get(alice.address).weight > 0n;
    if (won) {
      await crash.claim(id, alice.address);
      model.claim(id, alice.address);
    }
    await sync("V8b settle/register/claim (sink still reverting)", ctx);

    // V9: void under-threshold + carryForwardStake
    id = await crash.currentRoundId();
    await bet(ctx, alice, "0.3", 10001n);
    await lockAndFeed(ctx, carol); // 1 participant < 2 => void
    await sync("V9a void under-threshold", ctx);
    await crash.connect(alice).carryForwardStake(id);
    model.carryForwardStake(id, alice.address);
    await sync("V9b carryForward", ctx);

    // V10: voidStaleRound
    await bet(ctx, bob, "0.3", 0n);
    const { id: id10 } = await lockAndFeed(ctx, carol);
    await networkHelpers.mine(AWAIT + 1);
    {
      const tx = await crash.voidStaleRound(id10);
      const rc = await tx.wait();
      const blk = await ethers.provider.getBlock(rc.blockNumber);
      model.voidStaleRound(id10, BigInt(blk!.timestamp));
    }
    await sync("V10 voidStaleRound", ctx);

    // V11: claimRake to treasury escrow
    await crash.claimRake();
    model.claimRake(ctx.treasury.address);
    await sync("V11 claimRake", ctx);

    // model-side invariants held throughout (assertConservation ran on every step)
    expect(model.incomeBoundHolds()).to.equal(true);
  });

  it("V15: hwm-drawdown seed halt (reason 2) matches", async () => {
    const ctx = await deployPair({ hwmDrawdownBps: 100n, jackpotSink: ethers.ZeroAddress, reserveCap: 0n, seedBootstrapBudgetWei: E("100") });
    const { crash, model, alice, bob, carol, deployer } = ctx;
    model.cfg.jackpotSink = null;
    await crash.fundVault({ value: E("1") });
    model.fundVault(E("1"));
    // Round A: seeds are drawn at the round STARTED here; the halt trips one
    // round later, once reserve sits ~5% below the hwm (hwmDrawdownBps=100).
    for (const tag of ["v15a", "v15b"]) {
      const id = await crash.currentRoundId();
      await bet(ctx, alice, "0.5", 10001n);
      await bet(ctx, bob, "0.5", 0n);
      await lockAndFeed(ctx, carol);
      await revealAndFeed(ctx, id, randomnessFor(tag, (e) => e >= 2n && e <= 40n), bob);
      await settleAndFeed(ctx, id, deployer);
      await networkHelpers.mine(REG + 1);
    }
    await sync("V15 second settle → next round must be seed-halted (hwm)", ctx);
    // the round started inside settle must have seeded 0 with reason 2
    const nr = model.round();
    expect(nr.rolledOverFromPrevious).to.equal(0n);
    expect(model.events.filter((e: any) => e.name === "SeedHalted").map((e: any) => e.reason)).to.include(2);
    expect(await crash.seedHaltReason()).to.equal(2n);
  });

  it("V16: floor==cap seedless config RE-SEEDS after busted-pot inflow + FAILED spill", async () => {
    const ctx = await deployPair({ reserveFloorWei: E("2"), reserveCap: E("2") });
    const { crash, sink, model, alice, bob, carol, deployer } = ctx;
    await crash.fundVault({ value: E("2") });
    model.fundVault(E("2"));
    await sync("V16a funded to floor==cap", ctx);
    expect(await crash.nextSeed()).to.equal(0n); // seedless as designed

    // busted round, then sweep with sink REVERTING → reserve > floor
    const id = await crash.currentRoundId();
    expect(model.round(id).rolledOverFromPrevious).to.equal(0n);
    await bet(ctx, alice, "0.8", 0n);
    await bet(ctx, bob, "0.8", 0n);
    await lockAndFeed(ctx, carol);
    await revealAndFeed(ctx, id, randomnessFor("v16", (e) => e >= 1n && e <= 40n), carol);
    await settleAndFeed(ctx, id, carol);
    await crash.registerResult(id, alice.address);
    model.registerResult(id, alice.address);
    await crash.registerResult(id, bob.address);
    model.registerResult(id, bob.address);
    await networkHelpers.mine(REG + 1);
    await sink.setReverting(true);
    model.sinkOk = false;
    await crash.sweepBustedRound(id);
    model.sweepBustedRound(id);
    await sync("V16b busted sweep, sink reverting → stranded above floor", ctx);
    expect(model.strandedOverflow).to.be.gt(0n);

    // THE DEMONSTRATION: the "seedless" config now reports a nonzero next seed
    const ns = await crash.nextSeed();
    expect(ns).to.be.gt(0n);
    // and the next started round actually seeds — play one more round through settle
    const id2 = await crash.currentRoundId();
    await bet(ctx, alice, "0.5", 10001n);
    await bet(ctx, bob, "0.5", 0n);
    await lockAndFeed(ctx, carol);
    await revealAndFeed(ctx, id2, randomnessFor("v16b", (e) => e >= 2n && e <= 40n), bob);
    await settleAndFeed(ctx, id2, deployer);
    await sync("V16c settle: next round SEEDED despite floor==cap design", ctx);
    const seeded = model.round().rolledOverFromPrevious;
    expect(seeded).to.be.gt(0n);
    const cr = await crash.rounds(model.currentRoundId);
    expect(cr.rolledOverFromPrevious).to.equal(seeded);
    transcript.push({ label: "V16 REACTIVATION PROOF", nextSeedAfterFailedSpill: ns.toString(), actualSeedNextRound: seeded.toString() });
  });
});
