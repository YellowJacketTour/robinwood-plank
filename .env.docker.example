# Local Docker Desktop / Compose environment. Never reuse this password in
# cPanel and never commit a populated copy.
PLANK_IMAGE=plank-love-inmotion:local
PLANK_BIND_ADDRESS=127.0.0.1
PLANK_APP_PORT=3000
PLANK_DB_PORT=54329
DEPLOYMENT_VERSION=local

POSTGRES_DB=plank
POSTGRES_USER=plankapp
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
PGPOOL_MAX=4

# Public build values
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKET_ENABLED=true
# LIVE since 2026-08-01: MarketplankVaultV3 ("Premium Plank Liquidity") is the
# primary vault. V1 (Driftwood) and V2 (WormWood) are legacy, redeem-only —
# WormWood (0xc4B29D7a…) has a critical LP drain and must never be
# recommended for new deposits or LP. Never drop a legacy from the list below
# until its vault reads empty.
NEXT_PUBLIC_MARKET_VAULT_ADDRESS=0xacE28f72Fc3e15eA1671e689806694A9b0cE047D
NEXT_PUBLIC_MARKET_VAULT_LEGACY_ADDRESS=
NEXT_PUBLIC_MARKET_VAULT_LEGACY_ADDRESSES=0xb2019Fd4cA24502e812C0C73b751Fa49979BF708,0xc4B29D7a01603D2A5937b1FC86ea85E488d72e04
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RULES_RELAXED=true
NEXT_PUBLIC_TRADE_PAUSED=false
NEXT_PUBLIC_TRADE_OPENS_AT=2026-07-25T21:20:00.000Z
NEXT_PUBLIC_MINT_START_AT=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only values
UNISWAP_API_KEY=
RELAYER_PRIVATE_KEY=
CRON_SECRET=
RPC_URL=https://rpc.mainnet.chain.robinhood.com
BEACON_ADDRESS=0x87d584df130FED0Fe540954eD48CE2691A18D619
AIRDROP_TOTAL_SUPPLY=
AIRDROP_POOL_TOKENS=
AIRDROP_PERCENT_OF_SUPPLY=
AIRDROP_EXTRA=
GOOD_WOOD_EXTRA=

# Optional. OpenSea API v2 (collection volume/listings on Robinhood Chain).
# Leave unset and the app self-manages a free key: scripts/refresh-market-data.ts
# mints one and renews it before the 30-day expiry, storing it in PostgreSQL.
# Set this ONLY to pin a full, non-expiring key from opensea.io/settings/developer
# — an explicit value takes precedence and is never rotated. Server-only.
OPENSEA_API_KEY=

# Optional. Lets /admin -> Collections dispatch deploy-vault-v3.yml directly.
# Fine-grained token scoped to actions:write on this repo only. Server-only.
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPO=
GITHUB_DISPATCH_REF=

# 0x Swap API key (price competition + cross-chain quotes). Server-only.
ZEROX_API_KEY=

# MoonPay fiat on/off-ramp (lib/moonpay-server.ts). Hard off unless
# NEXT_PUBLIC_MOONPAY_ENABLED=true. See .env.inmotion.example for the full note.
NEXT_PUBLIC_MOONPAY_ENABLED=false
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_ENV=sandbox
# Webhook Key (wk_*), verifies inbound order webhooks. Distinct from the
# sk_* secret above. See .env.inmotion.example for the full note.
MOONPAY_WEBHOOK_KEY=
ALCHEMY_API_KEY=
# Optional. Alchemy network slug; defaults to robinhood-mainnet (chain 4663).
# Use robinhood-testnet against the testnet.
ALCHEMY_NETWORK=
AIRDROP_TOTAL_SUPPLY=
AIRDROP_POOL_TOKENS=
AIRDROP_PERCENT_OF_SUPPLY=

# Optional. Community Meme Vault (https://memes.smoothbrain.app/developers)
# key powering /memes. Reads work WITHOUT it — the key only raises the rate
# limit (1,000 reads/hr, 20 submissions/hr) — so an unset value degrades to a
# smaller budget, never to an outage. Submit-capable, so it is server-only and
# must never be NEXT_PUBLIC_. The app proxies every call through /api/memes so
# the key stays here and all visitors share one cached budget.
#
# Installing it: store as the repo secret MEMES_VAULT_API, then run the
# InMotion Passenger CI/CD workflow with operation=set-dispatch-token — that
# job writes it here alongside the vault dispatch token.
MEMES_VAULT_API=
