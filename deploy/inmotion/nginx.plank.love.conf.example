# Install as an InMotion VPS nginx vhost only after replacing the certificate
# paths and confirming nothing else owns plank.love. If cPanel/WHM manages the
# web server, use its supported vhost include mechanism instead of editing the
# generated nginx/apache configuration directly.

server {
    listen 80;
    listen [::]:80;
    server_name plank.love www.plank.love;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://plank.love$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name plank.love www.plank.love;

    ssl_certificate /etc/letsencrypt/live/plank.love/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/plank.love/privkey.pem;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # The app intentionally holds this EventSource connection for ~290s.
    location = /api/market/vault/stream {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 310s;
        proxy_send_timeout 310s;
        add_header X-Accel-Buffering no always;
    }
}
