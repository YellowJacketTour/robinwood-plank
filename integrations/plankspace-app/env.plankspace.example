NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated, exact HTTPS origins allowed to supply the shared
# Plank.love wallet bridge during development or testing.
NEXT_PUBLIC_PLANKSPACE_PARENT_ORIGINS=

# Server-side equivalent used to generate frame-ancestors in the Worker CSP.
PLANKSPACE_PARENT_ORIGINS=
# Jitsi media host used by Woodstock Live. Public meet.jit.si works for
# development; production should use a controlled Jitsi/JaaS deployment.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# RPC endpoints used only to verify Toss a Chip transaction receipts.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
ROBINHOOD_CHAIN_RPC_URL=
