# Passenger production environment. Keep the real file at:
#   /home/CPANEL_USER/plank.tanggang.life/shared/.env.production
# with mode 600. Never commit it.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
DURABLE_KV_BACKEND=postgres

# cPanel PostgreSQL Database Wizard values. cPanel prefixes the database and
# username with the account name.
PGHOST=localhost
PGPORT=5432
PGDATABASE=CPANEL_USER_plank
PGUSER=CPANEL_USER_plankapp
PGPASSWORD=replace-with-the-real-database-password
PGPOOL_MAX=4
PGSSLMODE=disable

# Public values are also supplied as GitHub repository variables during build.
# plank.tanggang.life remains the verified InMotion hostname until the
# plank.love cPanel/Cloudflare cutover is complete.
NEXT_PUBLIC_SITE_URL=https://plank.tanggang.life
NEXT_PUBLIC_MARKET_ENABLED=true
# LIVE since 2026-08-01: MarketplankVaultV3 ("Premium Plank Liquidity") is the
# primary vault. V1 (Driftwood) and V2 (WormWood) are legacy, redeem-only —
# WormWood (0xc4B29D7a…) has a critical LP drain
# (audit held privately) and must never be recommended for
# new deposits or LP. Never drop a legacy from the list below until its vault
# reads empty.
NEXT_PUBLIC_MARKET_VAULT_ADDRESS=0xacE28f72Fc3e15eA1671e689806694A9b0cE047D
NEXT_PUBLIC_MARKET_VAULT_LEGACY_ADDRESS=
NEXT_PUBLIC_MARKET_VAULT_LEGACY_ADDRESSES=0xb2019Fd4cA24502e812C0C73b751Fa49979BF708,0xc4B29D7a01603D2A5937b1FC86ea85E488d72e04
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RULES_RELAXED=true
NEXT_PUBLIC_TRADE_PAUSED=false
NEXT_PUBLIC_TRADE_OPENS_AT=2026-07-25T21:20:00.000Z
NEXT_PUBLIC_MINT_START_AT=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only values. CI installs UNISWAP_API_KEY from the GitHub Actions
# secret into shared/runtime-secrets/uniswap-api-key with mode 600.
#
# RELAYER_PRIVATE_KEY is intentionally absent. The provisioning workflow
# installs it separately at shared/runtime-secrets/relayer.env for cPanel cron;
# Passenger must never load it.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
BEACON_ADDRESS=0x87d584df130FED0Fe540954eD48CE2691A18D619

# Wallets allowed to sign /admin mutations (comma-separated, server-only).
# When unset, lib/admin-auth.ts falls back to the two treasury wallets
# hard-coded in lib/constants.ts (SITE_FEE.recipient, MARKET_FEE_RECIPIENT).
PLANK_ADMIN_ADDRESSES=

# Admin media uploads (/admin → Music). Point at a directory under shared/ so
# uploads survive immutable releases, e.g.
# /home/CPANEL_USER/plank.tanggang.life/shared/uploads
# Unset = .data/uploads under the app dir (fine for dev only).
UPLOADS_DIR=

# The drand relayer cron's log file (the >> target in the cPanel cron line —
# see docs/INMOTION_DEPLOYMENT.md). Lets /admin → System show the last run.
# e.g. /home/CPANEL_USER/plank.tanggang.life/logs/drand-relayer.log
RELAYER_LOG_PATH=

# Optional legacy HTTP settlement endpoint. Remove after the standalone
# relayer cron has passed its 24-hour takeover verification.
CRON_SECRET=

# Optional airdrop / Boards overrides
AIRDROP_TOTAL_SUPPLY=
AIRDROP_POOL_TOKENS=
AIRDROP_PERCENT_OF_SUPPLY=
AIRDROP_EXTRA=
GOOD_WOOD_EXTRA=

# Optional. Lets /admin -> Collections dispatch
# .github/workflows/deploy-vault-v3.yml directly (new collection vault
# deploys) instead of an admin needing GitHub Actions access. A fine-grained
# PAT (or GitHub App token) scoped to `actions: write` on this repo only —
# NOT a broad admin token. Unset = the form renders disabled with a note to
# use the Actions tab instead (graceful degradation, same as OPENSEA_API_KEY
# below). Server-only; never NEXT_PUBLIC_.
#
# Installing it: GitHub refuses to store any secret or variable whose name
# begins with GITHUB_, so it cannot be called this on the CI side. Store it as
# the repo secret VAULT_DISPATCH_TOKEN, then run the InMotion Passenger CI/CD
# workflow with operation=set-dispatch-token. That job reads the secret (only
# a job running inside Actions can — the API never returns a stored secret's
# value) and writes it into this file under the name below, then restarts
# Passenger. Pasting it in by hand works too; the workflow exists so the
# credential never passes through a terminal, clipboard, or chat window.
GITHUB_DISPATCH_TOKEN=
# Optional overrides — defaults match this repo (lib/market/vault-deploy-v3.ts
# callers hardcode nothing; app/api/admin/vault-deploy/route.ts reads these).
GITHUB_DISPATCH_REPO=
GITHUB_DISPATCH_REF=

# Optional. OpenSea API v2 (collection volume/listings on Robinhood Chain).
# Leave unset and the app self-manages a free key: scripts/refresh-market-data.ts
# mints one and renews it before the 30-day expiry, storing it in PostgreSQL.
# Set this ONLY to pin a full, non-expiring key from opensea.io/settings/developer
# — an explicit value takes precedence and is never rotated. Server-only.
OPENSEA_API_KEY=

# 0x Swap API key (price competition + cross-chain quotes). Server-only.
ZEROX_API_KEY=

# Referral attribution (lib/referral-server.ts). Hard off unless set to
# "true" -- attribution tracking only, no payout amount. See that file's
# header for why payouts are a separate, not-yet-built decision.
NEXT_PUBLIC_REFERRAL_ENABLED=false
ALCHEMY_API_KEY=
# Optional. Alchemy network slug; defaults to robinhood-mainnet (chain 4663).
# Use robinhood-testnet against the testnet.
ALCHEMY_NETWORK=

# Envio HyperSync token, required for discover-hypersync and
# discover-hypersync-backfill (lib/market/multichain/discovery/
# hypersync-evm-scan.ts) -- fails those two steps closed with a clear
# per-chain error, not a crash, when unset; every other refresh target is
# unaffected. Free, no card, generated at https://envio.dev/app/api-tokens.
# Server-only -- never NEXT_PUBLIC_.
ENVIO_API_TOKEN=

# Helius API key, required for discover-solana-collections
# (lib/market/multichain/discovery/helius-collection-scan.ts and
# lib/market/multichain/adapters/helius-solana.ts) -- exhaustive discovery
# of Metaplex Core-standard Solana collections via the DAS API. Fails that
# one step closed with a clear error when unset. Free dev tier, no card,
# generated at https://dashboard.helius.dev. Server-only.
HELIUS_API_KEY=

# Optional. Solana RPC endpoint used for real on-chain reads (Magic Eden M2
# program PDA lookups, see lib/market/multichain/adapters/magiceden-m2-onchain.ts)
# and for building/sending Solana buy/sweep/send transactions client-side.
# Unset falls back to Solana's public mainnet-beta RPC, which is rate-limited
# and NOT recommended for production traffic.
# NEVER put an API key in NEXT_PUBLIC_* — that string is shipped to every
# browser. Use a public RPC here, or SOLANA_RPC_URL (server-only) for keyed
# Helius/Alchemy/QuickNode endpoints.
NEXT_PUBLIC_SOLANA_RPC_URL=
SOLANA_RPC_URL=

# Optional. Magic Eden v2 API key (Solana buy_now/sell/buy-offer instruction
# endpoints — see lib/market/multichain/adapters/magiceden-solana-trade.ts's
# own header for the exact endpoints and their real, disclosed risks). Unset
# means Solana buy/sweep/offer-placement fails closed with a clear error;
# read-only stats/listings (magiceden-solana.ts) work keyless regardless.
# Server-only; never NEXT_PUBLIC_.
MAGICEDEN_API_KEY=

# Optional. UniSat Open API key (Bitcoin Ordinals collection listings +
# buy/sweep/send — see lib/market/multichain/trading/unisat-ordinals-trade.ts's
# and solana-bitcoin-listings.ts's own headers). Free tier: register at
# UniSat's Developer Center (docs.unisat.io), no KYC, ~2,000 calls/day.
# Unset means the Bitcoin Ordinals branch of every multichain route fails
# closed with a clear 503 rather than showing fabricated/empty data as if
# it were real. Server-only; never NEXT_PUBLIC_.
UNISAT_API_KEY=

# Optional. Ordiscan API key (Bitcoin Ordinals collection discovery + stats
# -- see lib/market/multichain/discovery/ordiscan-collection-scan.ts's and
# lib/market/multichain/adapters/ordiscan-ordinals.ts's own headers). Second,
# independent source alongside UniSat above -- Ordiscan's own collection
# registry, no floor-price/marketplace-stats endpoint exists in this API
# (confirmed live), so its snapshots carry real name/description/item_count
# only. Get a key at ordiscan.com/docs. Unset means the discover-ordiscan-
# collections step and the ordiscan-ordinals sync adapter both fail
# closed with a clear error rather than showing fabricated/empty data as if
# it were real. Server-only; never NEXT_PUBLIC_.
ORDISCAN_API_KEY=

# Optional legacy HTTP settlement endpoint. Remove after the standalone
# relayer cron has passed its 24-hour takeover verification.

# Optional. Community Meme Vault (https://memes.smoothbrain.app/developers)
# key powering /memes. Reads work WITHOUT it — the key only raises the rate
# limit (1,000 reads/hr, 20 submissions/hr) — so an unset value degrades to a
# smaller budget, never to an outage. Submit-capable, so it is server-only and
# must never be NEXT_PUBLIC_. The app proxies every call through /api/memes so
# the key stays here and all visitors share one cached budget.
#
# Installing it: store as the repo secret MEMES_VAULT_API, then run the
# InMotion Passenger CI/CD workflow with operation=set-dispatch-token — that
# job writes it here alongside the vault dispatch token.
MEMES_VAULT_API=
