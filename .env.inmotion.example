# Copy to .env.inmotion on the VPS. Never commit the real file.

# Image and listener
PLANK_IMAGE=plank-love-inmotion:local
PLANK_BIND_ADDRESS=127.0.0.1
PLANK_APP_PORT=3000
DEPLOYMENT_VERSION=local

# Private Valkey persistence. Generate with:
#   openssl rand -base64 48
VALKEY_PASSWORD=replace-with-a-long-random-password

# Start with "upstash" during a zero-data-loss DNS cutover if the current site
# already has live orders. Switch to "redis" after migration is verified.
DURABLE_KV_BACKEND=redis

# Needed when DURABLE_KV_BACKEND=upstash and during the one-time
# Upstash -> Valkey migration. Remove the real values from the VPS after the
# backend is switched to redis and the migration is verified.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public values inlined during `docker build`
NEXT_PUBLIC_SITE_URL=https://plank.love
NEXT_PUBLIC_MARKET_ENABLED=true
NEXT_PUBLIC_MARKET_VAULT_ADDRESS=0xc4B29D7a01603D2A5937b1FC86ea85E488d72e04
NEXT_PUBLIC_MARKET_VAULT_LEGACY_ADDRESS=0xb2019Fd4cA24502e812C0C73b751Fa49979BF708
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RULES_RELAXED=true
NEXT_PUBLIC_TRADE_PAUSED=false
NEXT_PUBLIC_TRADE_OPENS_AT=2026-07-25T21:20:00.000Z
NEXT_PUBLIC_MINT_START_AT=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only secrets; injected at container runtime
UNISWAP_API_KEY=
RELAYER_PRIVATE_KEY=
CRON_SECRET=
RPC_URL=https://rpc.mainnet.chain.robinhood.com
BEACON_ADDRESS=0x87d584df130FED0Fe540954eD48CE2691A18D619

# Optional airdrop / boards overrides
AIRDROP_TOTAL_SUPPLY=
AIRDROP_POOL_TOKENS=
AIRDROP_PERCENT_OF_SUPPLY=
AIRDROP_EXTRA=
GOOD_WOOD_EXTRA=
