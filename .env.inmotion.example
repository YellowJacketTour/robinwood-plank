# Passenger production environment. Keep the real file at:
#   /home/CPANEL_USER/plank.tanggang.life/shared/.env.production
# with mode 600. Never commit it.

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
DURABLE_KV_BACKEND=postgres

# cPanel PostgreSQL Database Wizard values. cPanel prefixes the database and
# username with the account name.
PGHOST=localhost
PGPORT=5432
PGDATABASE=CPANEL_USER_plank
PGUSER=CPANEL_USER_plankapp
PGPASSWORD=replace-with-the-real-database-password
PGPOOL_MAX=4
PGSSLMODE=disable

# Public values are also supplied as GitHub repository variables during build.
# plank.tanggang.life remains the verified InMotion hostname until the
# plank.love cPanel/Cloudflare cutover is complete.
NEXT_PUBLIC_SITE_URL=https://plank.tanggang.life
NEXT_PUBLIC_MARKET_ENABLED=true
NEXT_PUBLIC_MARKET_VAULT_ADDRESS=0xc4B29D7a01603D2A5937b1FC86ea85E488d72e04
NEXT_PUBLIC_MARKET_VAULT_LEGACY_ADDRESS=0xb2019Fd4cA24502e812C0C73b751Fa49979BF708
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RULES_RELAXED=true
NEXT_PUBLIC_TRADE_PAUSED=false
NEXT_PUBLIC_TRADE_OPENS_AT=2026-07-25T21:20:00.000Z
NEXT_PUBLIC_MINT_START_AT=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only values. CI installs UNISWAP_API_KEY from the GitHub Actions
# secret into shared/runtime-secrets/uniswap-api-key with mode 600.
#
# RELAYER_PRIVATE_KEY is intentionally absent. The provisioning workflow
# installs it separately at shared/runtime-secrets/relayer.env for cPanel cron;
# Passenger must never load it.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
BEACON_ADDRESS=0x87d584df130FED0Fe540954eD48CE2691A18D619

# Optional legacy HTTP settlement endpoint. Remove after the standalone
# relayer cron has passed its 24-hour takeover verification.
CRON_SECRET=

# Optional airdrop / Boards overrides
AIRDROP_TOTAL_SUPPLY=
AIRDROP_POOL_TOKENS=
AIRDROP_PERCENT_OF_SUPPLY=
AIRDROP_EXTRA=
GOOD_WOOD_EXTRA=

# Optional. OpenSea API v2 (collection volume/listings on Robinhood Chain).
# Leave unset and the app self-manages a free key: scripts/refresh-market-data.ts
# mints one and renews it before the 30-day expiry, storing it in PostgreSQL.
# Set this ONLY to pin a full, non-expiring key from opensea.io/settings/developer
# — an explicit value takes precedence and is never rotated. Server-only.
OPENSEA_API_KEY=

# 0x Swap API key (price competition + cross-chain quotes). Server-only.
ZEROX_API_KEY=
