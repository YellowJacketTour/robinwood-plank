# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.inmotion.example
!.env.docker.example

# vercel
.vercel

# cloudflare / open-next
.open-next
.wrangler
.dev.vars
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# Boards runtime state
data/boards-state.json

.data/

.hardhat-cache/
.hardhat-artifacts/
/types/
typechain-types/

# Standalone owner-run deploy tool (scripts/deploy-tool) — its own isolated
# npm install, build output, and compiled contract JSON are all regenerated
# locally per README.md; committing them risks shipping a stale artifact
# that silently deploys different bytecode than what's in contracts/.
scripts/deploy-tool/node_modules/
scripts/deploy-tool/wallet-bundle.js
scripts/deploy-tool/package-lock.json
scripts/deploy-tool/DrandBeacon.json
scripts/deploy-tool/MarketplankVault.json
.gstack/

# V3 deploy output artifact (contains deployed address; regenerated per run)
deploy-out/

# Local casino stack deploy manifest -- regenerated by
# scripts/local-casino-setup.ts on every run; crash.html auto-syncs to it,
# never committed (it's a snapshot of one machine's local deploy).
public/arcade/deploy-addresses.local.json

# Same reasoning, for scripts/testnet-casino-setup.ts's public-testnet
# deploy manifest -- a snapshot of one throwaway test deploy's addresses,
# not source.
public/arcade/deploy-addresses.testnet.json

# Playwright e2e regression suite (test/e2e) run artifacts
/test-results/
/playwright-report/
/blob-report/
test/e2e/.hardhat-node.pid
test/e2e/.casino-keeper.pid
