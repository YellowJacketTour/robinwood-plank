{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": ".hardhat-cache/ts-out"
  },
  "include": [
    "hardhat.config.ts",
    "test/contracts/**/*.ts",
    "scripts/deploy-vault.ts",
    "scripts/deploy-index-vault.ts",
    "scripts/seed-index-vault-genesis.ts",
    "scripts/configure-index-vault-governance.ts",
    "scripts/config/index-vault-deploy-config.ts",
    "scripts/deploy/axiom1-local.ts",
    "scripts/deploy/axiom1-testnet.ts",
    "scripts/verify/axiom1-postdeploy.ts",
    "scripts/gas/axiom1-gas-snapshot.ts"
  ],
  "exclude": ["node_modules"]
}
