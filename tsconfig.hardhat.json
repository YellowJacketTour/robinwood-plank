{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": ".hardhat-cache/ts-out"
  },
  "include": ["hardhat.config.ts", "test/contracts/**/*.ts", "scripts/deploy-vault.ts"],
  "exclude": ["node_modules"]
}
